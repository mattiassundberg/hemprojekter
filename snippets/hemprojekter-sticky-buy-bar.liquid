{%- assign product = all_products[settings.hp_sticky_product] -%}

{%- if product != blank -%}
  {%- assign sticky_img = 'https://d8j0ntlcm91z4.cloudfront.net/user_3DreXrQjfR3HAlY8BXUgsMLjIwT/hf_20260518_072645_ffd23c8a-39b9-4d65-9fef-677b34f63e4f.png' -%}
  {%- if product.featured_image -%}
    {%- assign sticky_img = product.featured_image | image_url: width: 240 -%}
  {%- endif -%}
  <div class="hp-sticky" data-hp-sticky aria-hidden="true" inert>
    <div class="hp-sticky__inner">
      <div class="hp-sticky__media">
        <img class="hp-sticky__img" src="{{ sticky_img }}" alt="{{ product.title | escape }}" width="160" height="160" loading="lazy">
        <span class="hp-sticky__badge" aria-hidden="true">★ 4.8</span>
      </div>
      <div class="hp-sticky__text">
        <p class="hp-sticky__title">{{ product.title }}</p>
        <p class="hp-sticky__price">
          <span class="hp-sticky__amount">{{ product.price | money }}</span>
          <span class="hp-sticky__klarna">eller 4× {{ product.price | divided_by: 4 | money }} via Klarna</span>
        </p>
      </div>
      <form method="post" action="{{ routes.cart_add_url }}" class="hp-sticky__form" data-cart-add-form>
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="hp-button hp-button--primary hp-sticky__btn">Lägg i varukorg</button>
      </form>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .hp-sticky {
    position: fixed;
    left: 16px; right: 16px;
    bottom: 16px;
    z-index: 60;
    background: linear-gradient(180deg, rgba(20, 17, 31, 0.94), rgba(7, 6, 12, 0.96));
    color: var(--hp-text);
    border: 1px solid rgba(244, 183, 102, 0.28);
    border-radius: 22px;
    backdrop-filter: saturate(140%) blur(18px);
    -webkit-backdrop-filter: saturate(140%) blur(18px);
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.75),
      0 10px 40px -10px rgba(244, 183, 102, 0.15);
    transform: translateY(140%);
    opacity: 0;
    transition: transform 480ms var(--hp-ease), opacity 320ms var(--hp-ease);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-sticky { transition: opacity 200ms var(--hp-ease); transform: none; }
  }
  .hp-sticky.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }
  body.hp-cart-open .hp-sticky {
    transform: translateY(140%);
    opacity: 0;
    pointer-events: none;
  }
  .hp-sticky__inner {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: 26px;
    padding: 18px 22px 18px 18px;
    max-width: 1180px;
    margin: 0 auto;
  }
  .hp-sticky__media {
    position: relative;
    width: 96px; height: 96px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid rgba(244, 183, 102, 0.32);
    background: var(--hp-surface);
  }
  .hp-sticky__img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .hp-sticky__badge {
    position: absolute;
    bottom: 6px; right: 6px;
    font-family: var(--hp-font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(7, 6, 12, 0.88);
    color: var(--hp-aurora-1);
    border: 1px solid rgba(244, 183, 102, 0.55);
  }

  .hp-sticky__text { min-width: 0; }
  .hp-sticky__title {
    margin: 0;
    font-family: var(--hp-font-display);
    font-weight: 400;
    font-size: 1.65rem;
    letter-spacing: -0.015em;
    line-height: 1.1;
    color: var(--hp-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hp-sticky__price {
    margin: 6px 0 0;
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hp-sticky__amount {
    font-family: var(--hp-font-display);
    font-style: italic;
    font-size: 1.9rem;
    color: var(--hp-aurora-1);
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .hp-sticky__klarna {
    font-family: var(--hp-font-mono);
    font-size: 1rem;
    letter-spacing: 0.04em;
    color: var(--hp-text-muted);
  }

  .hp-sticky__btn {
    padding: 1.15em 2em;
    font-size: 1.2rem;
    font-weight: 600;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .hp-sticky { left: 0; right: 0; bottom: 0; border-radius: 22px 22px 0 0; border-bottom: 0; padding-bottom: env(safe-area-inset-bottom); }
    .hp-sticky__inner { grid-template-columns: 64px 1fr auto; gap: 14px; padding: 14px 16px; }
    .hp-sticky__media { width: 64px; height: 64px; border-radius: 12px; }
    .hp-sticky__title { font-size: 1.15rem; }
    .hp-sticky__amount { font-size: 1.4rem; }
    .hp-sticky__klarna { display: none; }
    .hp-sticky__badge { display: none; }
    .hp-sticky__btn { padding: 0.95em 1.4em; font-size: 1.05rem; }
  }
{% endstylesheet %}
