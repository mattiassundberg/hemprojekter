<section class="hp-demo" id="demo">
  <div class="hp-container--wide hp-demo__head hp-reveal">
    <div class="hp-section-label">
      <span class="hp-section-label__num">02 / 06</span>
      <span class="hp-section-label__title">Före / Efter</span>
    </div>
    <div class="hp-demo__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-display hp-demo__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hp-body hp-demo__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- assign after_src = 'https://cdn.shopify.com/s/files/1/0939/9867/8401/files/demo-after.png?v=1779053709' -%}
  {%- assign before_src = 'https://cdn.shopify.com/s/files/1/0939/9867/8401/files/demo-before.png?v=1779053705' -%}
  {%- if section.settings.image_after != blank -%}
    {%- assign after_src = section.settings.image_after | image_url: width: 2400 -%}
  {%- endif -%}
  {%- if section.settings.image_before != blank -%}
    {%- assign before_src = section.settings.image_before | image_url: width: 2400 -%}
  {%- endif -%}

  <div class="hp-demo__stage-wrap hp-container--wide hp-reveal hp-reveal--lg">
    <div class="hp-demo__stage">
      {%- if section.settings.mode == 'video' and section.settings.video != blank -%}
        <video class="hp-demo__video" poster="{{ before_src }}" autoplay muted loop playsinline preload="metadata">
          {%- for source in section.settings.video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      {%- else -%}
        <hp-before-after class="hp-demo__ba" tabindex="0" aria-label="Före och efter — använd piltangenter eller dra för att jämföra">
          <img class="hp-demo__img hp-demo__img--after" src="{{ after_src }}" alt="Hemmabio på vägg — projektor aktiv" loading="lazy" width="2400" height="1350">
          <img class="hp-demo__img hp-demo__img--before" src="{{ before_src }}" alt="Tom vägg — projektor av" loading="lazy" width="2400" height="1350">
          <span class="hp-demo__handle" aria-hidden="true"><span class="hp-demo__handle-dot"></span></span>
          <span class="hp-demo__label hp-demo__label--before" aria-hidden="true">Före</span>
          <span class="hp-demo__label hp-demo__label--after" aria-hidden="true">Efter</span>
        </hp-before-after>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hp-demo {
    padding-block: var(--hp-section-pad-y);
    position: relative;
  }

  .hp-demo__head {
    display: grid;
    gap: 36px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  .hp-demo__intro {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    align-items: end;
  }
  @media (min-width: 880px) {
    .hp-demo__intro { grid-template-columns: 1.4fr 1fr; gap: 56px; }
  }
  .hp-demo__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    margin: 0;
    text-wrap: balance;
    letter-spacing: -0.03em;
    max-width: 18ch;
  }
  .hp-demo__sub { margin: 0; max-width: 42ch; align-self: end; }

  .hp-demo__stage-wrap { position: relative; }
  .hp-demo__stage {
    border-radius: var(--hp-radius-xl);
    overflow: hidden;
    border: 1px solid var(--hp-border-strong);
    background: var(--hp-surface);
    aspect-ratio: 21 / 9;
    position: relative;
    box-shadow:
      0 80px 180px -60px rgba(0, 0, 0, 0.9),
      0 40px 100px -30px rgba(244, 183, 102, 0.18);
  }
  @media (max-width: 720px) {
    .hp-demo__stage { aspect-ratio: 4 / 3; }
  }

  .hp-demo__video { width: 100%; height: 100%; object-fit: cover; display: block; }

  hp-before-after {
    display: block;
    position: relative;
    width: 100%; height: 100%;
    overflow: hidden;
    cursor: ew-resize;
    user-select: none;
  }
  .hp-demo__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hp-demo__img--before { clip-path: inset(0 50% 0 0); }
  .hp-demo__handle {
    position: absolute;
    top: 0; bottom: 0;
    left: 50%;
    width: 1px;
    background: linear-gradient(180deg, transparent, rgba(244,183,102,0.9) 20%, rgba(244,183,102,0.9) 80%, transparent);
    transform: translateX(-0.5px);
    pointer-events: none;
  }
  .hp-demo__handle-dot {
    position: absolute;
    top: 50%; left: 50%;
    width: 52px; height: 52px;
    border-radius: 999px;
    background: var(--hp-bg-deep);
    border: 1px solid var(--hp-aurora-1);
    transform: translate(-50%, -50%);
    box-shadow: 0 16px 50px rgba(244, 183, 102, 0.4);
  }
  .hp-demo__handle-dot::before {
    content: "↔";
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--hp-aurora-1);
    font-family: var(--hp-font-mono);
    font-size: 0.9rem;
  }

  .hp-demo__label {
    position: absolute;
    top: 22px;
    font-family: var(--hp-font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(7,6,12,0.75);
    backdrop-filter: blur(8px);
    border: 1px solid var(--hp-border-strong);
    color: var(--hp-text);
  }
  .hp-demo__label--before { left: 22px; }
  .hp-demo__label--after { right: 22px; color: var(--hp-aurora-1); border-color: rgba(244,183,102,0.3); }

  hp-before-after:focus-visible {
    outline: 2px solid var(--hp-aurora-1);
    outline-offset: 4px;
  }
{% endstylesheet %}

<script>
  if (!customElements.get('hp-before-after')) {
    customElements.define('hp-before-after', class extends HTMLElement {
      connectedCallback() {
        this._before = this.querySelector('.hp-demo__img--before');
        this._handle = this.querySelector('.hp-demo__handle');
        if (!this._before || !this._handle) return;

        this._handle.style.left = '50%';
        this._dragging = false;

        this._setPos = (clientX) => {
          const rect = this.getBoundingClientRect();
          const pct = Math.max(0, Math.min(100, ((clientX - rect.left) / rect.width) * 100));
          this._before.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
          this._handle.style.left = pct + '%';
        };

        this._start = (e) => { this._dragging = true; this._setPos((e.touches ? e.touches[0] : e).clientX); };
        this._move  = (e) => { if (this._dragging) this._setPos((e.touches ? e.touches[0] : e).clientX); };
        this._end   = () => { this._dragging = false; };
        this._key   = (e) => {
          const rect = this.getBoundingClientRect();
          const current = parseFloat(this._handle.style.left || '50');
          if (e.key === 'ArrowLeft')  { e.preventDefault(); this._setPos(rect.left + rect.width * Math.max(0, current - 5) / 100); }
          if (e.key === 'ArrowRight') { e.preventDefault(); this._setPos(rect.left + rect.width * Math.min(100, current + 5) / 100); }
        };

        this.addEventListener('mousedown', this._start);
        this.addEventListener('touchstart', this._start, { passive: true });
        this.addEventListener('keydown', this._key);
        window.addEventListener('mousemove', this._move);
        window.addEventListener('touchmove', this._move, { passive: true });
        window.addEventListener('mouseup', this._end);
        window.addEventListener('touchend', this._end);
      }

      disconnectedCallback() {
        if (this._move) {
          window.removeEventListener('mousemove', this._move);
          window.removeEventListener('touchmove', this._move);
        }
        if (this._end) {
          window.removeEventListener('mouseup', this._end);
          window.removeEventListener('touchend', this._end);
        }
      }
    });
  }
</script>

{% schema %}
{
  "name": "Demo — Showcase",
  "tag": "section",
  "class": "hp-section hp-section--demo",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Se det själv" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Tom vägg. På sekunder — hemmabio." },
    { "type": "textarea", "id": "subheading", "label": "Underrubrik", "default": "Dra reglaget. Samma vägg. Två världar — en med taklampa, en med 150 tum film." },
    { "type": "select", "id": "mode", "label": "Läge",
      "options": [
        { "value": "before_after", "label": "Före / efter-slider" },
        { "value": "video", "label": "Loopande video" }
      ],
      "default": "before_after"
    },
    { "type": "image_picker", "id": "image_before", "label": "Bild — före (lampor på)" },
    { "type": "image_picker", "id": "image_after", "label": "Bild — efter (projektor på)" },
    { "type": "video", "id": "video", "label": "Hero-video (mp4, används bara i video-läge)" }
  ],
  "presets": [ { "name": "Demo — Showcase" } ]
}
{% endschema %}
