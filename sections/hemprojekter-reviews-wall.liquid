{%- assign product = all_products[section.settings.product] -%}

<section class="hp-reviews">
  <div class="hp-container--wide">
    <div class="hp-section-label hp-reveal">
      <span class="hp-section-label__num">05 / 06</span>
      <span class="hp-section-label__title">{{ section.settings.kicker | default: 'Omdömen' }}</span>
    </div>

    <div class="hp-reviews__hero hp-reveal">
      <div class="hp-reviews__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="hp-display hp-reviews__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        <div class="hp-reviews__meta">
          <span class="hp-reviews__rating">{{ section.settings.avg_rating }}</span>
          <span class="hp-reviews__rating-sub">
            <span class="hp-reviews__stars" aria-hidden="true">★★★★★</span>
            <span>{{ section.settings.review_count }} omdömen</span>
          </span>
        </div>
      </div>

      {%- assign featured = section.blocks.first -%}
      {%- if featured -%}
        <figure class="hp-reviews__featured">
          <blockquote>"{{ featured.settings.quote }}"</blockquote>
          <figcaption>
            <span class="hp-reviews__featured-stars" aria-hidden="true">
              {%- assign rating = featured.settings.rating | plus: 0 -%}
              {%- for i in (1..5) -%}{% if i <= rating %}★{% else %}☆{% endif %}{%- endfor -%}
            </span>
            — {{ featured.settings.author }}{% if featured.settings.location != blank %}, {{ featured.settings.location }}{% endif %}
          </figcaption>
        </figure>
      {%- endif -%}
    </div>

    <ul class="hp-reviews__grid" role="list">
      {%- for block in section.blocks -%}
        {%- unless forloop.first -%}
          <li class="hp-review hp-reveal" {{ block.shopify_attributes }}>
            <div class="hp-review__stars" aria-label="{{ block.settings.rating }} av 5">
              {%- assign rating = block.settings.rating | plus: 0 -%}
              {%- for i in (1..5) -%}
                <span aria-hidden="true">{% if i <= rating %}★{% else %}☆{% endif %}</span>
              {%- endfor -%}
            </div>
            <blockquote class="hp-review__quote">"{{ block.settings.quote }}"</blockquote>
            <p class="hp-review__author">— {{ block.settings.author }}{% if block.settings.location != blank %}, {{ block.settings.location }}{% endif %}</p>
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{%- if product != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "image": [{{ product.featured_image | image_url: width: 1200 | json }}],
    "offers": {
      "@type": "Offer",
      "price": "{{ product.price | divided_by: 100.0 }}",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/InStock"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ section.settings.avg_rating }}",
      "reviewCount": "{{ section.settings.review_count }}"
    }
  }
  </script>
{%- endif -%}

{% stylesheet %}
  .hp-reviews { padding-block: var(--hp-section-pad-y); position: relative; }

  .hp-reviews__hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: end;
    margin-bottom: clamp(48px, 6vw, 96px);
  }
  @media (min-width: 880px) {
    .hp-reviews__hero { grid-template-columns: 1fr 1.2fr; }
  }

  .hp-reviews__head { display: grid; gap: 32px; align-content: end; }
  .hp-reviews__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    margin: 0;
    text-wrap: balance;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .hp-reviews__meta {
    display: flex;
    align-items: end;
    gap: 18px;
    padding-top: 22px;
    border-top: 1px solid var(--hp-border);
  }
  .hp-reviews__rating {
    font-family: var(--hp-font-display);
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--hp-aurora-1);
  }
  .hp-reviews__rating-sub {
    display: grid;
    gap: 6px;
    font-family: var(--hp-font-mono);
    font-size: 0.84rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hp-text-dim);
  }
  .hp-reviews__stars { color: var(--hp-aurora-1); letter-spacing: 3px; font-size: 1.05rem; }

  .hp-reviews__featured blockquote {
    margin: 0;
    font-family: var(--hp-font-display);
    font-style: italic;
    font-size: clamp(1.6rem, 2.8vw, 2.5rem);
    line-height: 1.2;
    color: var(--hp-text);
    text-wrap: balance;
  }
  .hp-reviews__featured figcaption {
    margin-top: 22px;
    font-family: var(--hp-font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.12em;
    color: var(--hp-text-dim);
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hp-reviews__featured-stars {
    color: var(--hp-aurora-3);
    letter-spacing: 3px;
    font-family: var(--hp-font-body);
    font-size: 1.05rem;
  }

  .hp-reviews__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    gap: 20px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .hp-reviews__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1080px) { .hp-reviews__grid { grid-template-columns: repeat(3, 1fr); } }

  .hp-review {
    padding: 32px 30px;
    border-radius: var(--hp-radius);
    border: 1px solid var(--hp-border);
    background: rgba(14,12,24,0.6);
    display: grid; gap: 16px;
    transition: border-color var(--hp-dur-med) var(--hp-ease), transform var(--hp-dur-med) var(--hp-ease);
  }
  .hp-review:hover { border-color: var(--hp-border-strong); transform: translateY(-2px); }
  .hp-review__stars { color: var(--hp-aurora-3); letter-spacing: 3px; font-size: 1.05rem; }
  .hp-review__quote {
    margin: 0;
    font-family: var(--hp-font-display);
    font-size: clamp(1.25rem, 1.45vw, 1.5rem);
    line-height: 1.35;
    color: var(--hp-text);
  }
  .hp-review__author {
    margin: auto 0 0;
    font-family: var(--hp-font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    color: var(--hp-text-dim);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews wall",
  "tag": "section",
  "class": "hp-section hp-section--reviews",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Omdömen" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Bara läs själv." },
    { "type": "text", "id": "subheading", "label": "Underrubrik", "default": "Verkliga omdömen från Hemprojekter-kunder." },
    { "type": "product", "id": "product", "label": "Kopplad produkt (för SEO-data)" },
    { "type": "text", "id": "avg_rating", "label": "Genomsnittsbetyg", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Antal omdömen", "default": "124" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Omdöme",
