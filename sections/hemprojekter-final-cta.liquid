<section class="hp-cta-final">
  <div class="hp-cta-final__bg" aria-hidden="true">
    <video class="hp-cta-final__video" autoplay muted loop playsinline preload="metadata"
           poster="https://cdn.shopify.com/s/files/1/0939/9867/8401/files/demo-after.png?v=1779053709">
      <source src="https://cdn.shopify.com/videos/c/o/v/f07717c51c434626a1b1ffd14f80b604.mp4" type="video/mp4">
    </video>
    <div class="hp-cta-final__scrim"></div>
    <div class="hp-aurora-bloom"></div>
  </div>

  <div class="hp-container--wide hp-cta-final__inner hp-reveal">
    <div class="hp-section-label">
      <span class="hp-section-label__num">06 / 06</span>
      <span class="hp-section-label__title">{{ section.settings.kicker | default: 'Klart att kolla' }}</span>
    </div>

    {%- if section.settings.heading != blank -%}
      <h2 class="hp-display hp-cta-final__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hp-body hp-cta-final__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <a class="hp-button hp-button--primary hp-cta-final__btn" href="{{ section.settings.cta_url }}">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
    {%- if section.settings.fine_print != blank -%}
      <p class="hp-cta-final__fine">{{ section.settings.fine_print }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .hp-cta-final {
    position: relative;
    isolation: isolate;
    min-height: 92svh;
    background: var(--hp-bg);
    overflow: hidden;
    display: grid;
    align-items: end;
  }
  .hp-cta-final__bg { position: absolute; inset: 0; z-index: 0; }
  .hp-cta-final__video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hp-cta-final__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(7,6,12,0.7) 0%, rgba(7,6,12,0.5) 25%, rgba(7,6,12,0.82) 65%, rgba(7,6,12,0.98) 100%),
      radial-gradient(80% 60% at 50% 100%, rgba(244,183,102,0.18), transparent 70%);
  }

  .hp-cta-final__inner {
    position: relative;
    z-index: 2;
    padding-block: clamp(48px, 8vw, 96px);
    display: grid;
    gap: 22px;
    max-width: 28ch;
  }
  .hp-cta-final__title {
    font-size: clamp(3rem, 9vw, 8rem);
    margin: 0;
    text-wrap: balance;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-shadow: 0 4px 40px rgba(0,0,0,0.55);
  }
  .hp-cta-final__sub {
    margin: 0;
    color: var(--hp-text);
    font-size: clamp(1.18rem, 1.55vw, 1.38rem);
    line-height: 1.5;
    max-width: 40ch;
    text-shadow: 0 2px 16px rgba(0,0,0,0.65);
  }
  .hp-cta-final__btn { margin-top: 16px; justify-self: start; }
  .hp-cta-final__fine {
    font-family: var(--hp-font-mono);
    font-size: 0.92rem;
    letter-spacing: 0.16em;
    color: rgba(251, 248, 243, 0.9);
    margin: 8px 0 0;
    text-shadow: 0 2px 10px rgba(0,0,0,0.55);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Final CTA",
  "tag": "section",
  "class": "hp-section hp-section--cta-final",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Klart att kolla" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Din hemmabio. Direkt på din vägg." },
    { "type": "textarea", "id": "subheading", "label": "Underrubrik", "default": "Beställ före kl 14 — skickas samma dag från Sverige." },
    { "type": "text", "id": "cta_label", "label": "CTA-text", "default": "Köp Mini-projektorn — 499 kr" },
    { "type": "url", "id": "cta_url", "label": "CTA-länk" },
    { "type": "text", "id": "fine_print", "label": "Liten text", "default": "Fri frakt över 499 kr · 30 dagars öppet köp · Klarna" }
  ],
  "presets": [ { "name": "Final CTA" } ]
}
{% endschema %}
