{%- assign story_img = 'https://cdn.shopify.com/s/files/1/0939/9867/8401/files/story-projector.png?v=1779053709' -%}
{%- assign story_alt = 'Mini-projektor och smartphone på nattduksbord i varmt skymningsljus' -%}
{%- if section.settings.image != blank -%}
  {%- assign story_img = section.settings.image | image_url: width: 1800 -%}
  {%- assign story_alt = section.settings.image.alt | default: story_alt -%}
{%- endif -%}

<section class="hp-story">
  <div class="hp-container--wide">
    <div class="hp-section-label hp-reveal">
      <span class="hp-section-label__num">04 / 06</span>
      <span class="hp-section-label__title">{{ section.settings.kicker | default: 'Idé' }}</span>
    </div>

    <div class="hp-story__grid">
      <div class="hp-story__media hp-reveal hp-reveal--lg">
        <img src="{{ story_img }}" alt="{{ story_alt | escape }}" width="1800" height="2250" loading="lazy">
        <div class="hp-story__glow" aria-hidden="true"></div>
        <span class="hp-story__caption hp-eyebrow-num" aria-hidden="true">Fig. 01 · Anslutning via WiFi</span>
      </div>

      <div class="hp-story__copy hp-reveal">
        {%- if section.settings.heading != blank -%}
          <h2 class="hp-display hp-story__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        <div class="hp-body hp-story__body">{{ section.settings.body }}</div>
        {%- if section.settings.cta_label != blank -%}
          <a class="hp-button hp-button--ghost hp-story__cta" href="{{ section.settings.cta_url }}">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .hp-story { padding-block: var(--hp-section-pad-y); position: relative; }

  .hp-story__grid {
    display: grid;
    gap: clamp(36px, 5vw, 88px);
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 960px) {
    .hp-story__grid { grid-template-columns: 1.15fr 1fr; }
  }

  .hp-story__media {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--hp-radius-xl);
    overflow: hidden;
    border: 1px solid var(--hp-border);
    isolation: isolate;
    box-shadow:
      0 80px 180px -60px rgba(0,0,0,0.85),
      0 30px 80px -30px rgba(167,139,250,0.25);
  }
  .hp-story__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hp-story__glow {
    position: absolute; inset: -25% -15% auto auto;
    width: 70%; aspect-ratio: 1;
    background: radial-gradient(circle, var(--hp-aurora-2) 0%, transparent 60%);
    filter: blur(80px); opacity: 0.55; mix-blend-mode: screen;
    pointer-events: none;
  }
  .hp-story__caption {
    position: absolute;
    bottom: 22px; left: 22px;
    padding: 8px 16px;
    background: rgba(7,6,12,0.7);
    backdrop-filter: blur(8px);
    border: 1px solid var(--hp-border-strong);
    border-radius: 999px;
    color: var(--hp-text);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
  }

  .hp-story__copy {
    display: grid;
    gap: 28px;
    max-width: 46ch;
  }
  .hp-story__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    margin: 0;
    text-wrap: balance;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .hp-story__body p { margin: 0 0 1em; }
  .hp-story__body p:last-child { margin-bottom: 0; }
  .hp-story__body p:first-child::first-letter {
    font-family: var(--hp-font-display);
    font-style: italic;
    font-size: 3.5em;
    float: left;
    line-height: 0.85;
    margin: 8px 12px 0 -2px;
    color: var(--hp-aurora-1);
  }
  .hp-story__cta { justify-self: start; margin-top: 8px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Story block",
  "tag": "section",
  "class": "hp-section hp-section--story",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Idé" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Slut på små skärmar." },
    { "type": "richtext", "id": "body", "label": "Text",
      "default": "<p>Mobilskärmen är liten. TV:n står där den står. Hemprojekter gör vilken tom vägg som helst till en biduk på upp till 150 tum — utan installation, utan kablar runt rummet, utan teknikångest.</p><p>Anslut din mobil, dator, TV-box eller spelkonsol via WiFi, Bluetooth, HDMI eller USB. Tryck play. Klart.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "cta_label", "label": "CTA-text", "default": "Köp Mini-projektorn" },
    { "type": "url", "id": "cta_url", "label": "CTA-länk" }
  ],
  "presets": [ { "name": "Story block" } ]
}
{% endschema %}
