<section class="hp-how">
  <div class="hp-container--wide">
    <div class="hp-section-label hp-reveal">
      <span class="hp-section-label__num">04½ / 06</span>
      <span class="hp-section-label__title">{{ section.settings.kicker | default: 'Process' }}</span>
    </div>

    {%- if section.settings.heading != blank -%}
      <h2 class="hp-display hp-how__title hp-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ol class="hp-how__list" role="list">
      {%- for block in section.blocks -%}
        <li class="hp-how__step hp-reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 80 }}ms">
          <span class="hp-how__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <div class="hp-how__line" aria-hidden="true"></div>
          <h3 class="hp-how__step-title">{{ block.settings.heading }}</h3>
          <p class="hp-body hp-how__step-body">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .hp-how { padding-block: var(--hp-section-pad-y); position: relative; }
  .hp-how__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    margin: 0 0 clamp(40px, 5vw, 72px);
    text-wrap: balance;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }

  .hp-how__list {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
  }
  @media (min-width: 880px) {
    .hp-how__list { grid-template-columns: repeat(3, 1fr); }
  }

  .hp-how__step {
    position: relative;
    padding: 36px 28px 32px;
    border-top: 1px solid var(--hp-border-strong);
    display: grid;
    gap: 14px;
    align-content: start;
  }
  @media (min-width: 880px) {
    .hp-how__step { border-top: none; border-left: 1px solid var(--hp-border-strong); }
    .hp-how__step:first-child { border-left: none; padding-left: 0; }
  }

  .hp-how__num {
    font-family: var(--hp-font-display);
    font-style: italic;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--hp-aurora-1);
  }

  .hp-how__line {
    width: 36px;
    height: 1px;
    background: linear-gradient(90deg, var(--hp-aurora-1), transparent);
  }

  .hp-how__step-title {
    font-family: var(--hp-font-display);
    font-weight: 400;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    margin: 0;
    color: var(--hp-text);
    letter-spacing: -0.01em;
  }
  .hp-how__step-body { margin: 0; max-width: 28ch; }
{% endstylesheet %}

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "hp-section hp-section--how",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Process" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Tre steg från låda till hemmabio." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Steg",
      "settings": [
        { "type": "text", "id": "heading", "label": "Steg-rubrik", "default": "Packa upp" },
        { "type": "textarea", "id": "text", "label": "Steg-text", "default": "Allt i lådan. Fjärrkontroll och kabel ingår." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "heading": "Packa upp", "text": "Allt i lådan. Fjärrkontroll och kabel ingår." } },
        { "type": "step", "settings": { "heading": "Anslut", "text": "Mobil, dator, TV-box eller spelkonsol — via WiFi, Bluetooth, HDMI eller USB." } },
        { "type": "step", "settings": { "heading": "Tryck play", "text": "150 tum hemmabio på din vägg. Hela rummet blir en salong." } }
      ]
    }
  ]
}
{% endschema %}
