<section class="hp-features">
  <div class="hp-container--wide">
    <div class="hp-section-label hp-reveal">
      <span class="hp-section-label__num">03 / 06</span>
      <span class="hp-section-label__title">{{ section.settings.kicker | default: 'Specs' }}</span>
    </div>

    {%- if section.settings.heading != blank -%}
      <h2 class="hp-display hp-features__title hp-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="hp-features__layout">
      {%- for block in section.blocks -%}
        {%- if forloop.first -%}
          <article class="hp-feature hp-feature--lead hp-reveal" {{ block.shopify_attributes }}>
            <span class="hp-feature__num">{{ block.settings.icon }}</span>
            <div class="hp-feature__body">
              <h3 class="hp-feature__title">{{ block.settings.heading }}</h3>
              <p class="hp-feature__text">{{ block.settings.text }}</p>
            </div>
            <div class="hp-feature__glow" aria-hidden="true"></div>
          </article>
        {%- else -%}
          <article class="hp-feature hp-feature--sm hp-reveal" {{ block.shopify_attributes }}>
            <span class="hp-feature__icon" aria-hidden="true">{{ block.settings.icon }}</span>
            <h3 class="hp-feature__title">{{ block.settings.heading }}</h3>
            <p class="hp-feature__text">{{ block.settings.text }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hp-features { padding-block: var(--hp-section-pad-y); position: relative; }

  .hp-features__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    margin: 0 0 clamp(40px, 5vw, 72px);
    text-wrap: balance;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }

  .hp-features__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .hp-features__layout { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1080px) {
    .hp-features__layout {
      grid-template-columns: 1.5fr 1fr 1fr;
      grid-auto-rows: minmax(0, auto);
      gap: 22px;
    }
    .hp-feature--lead { grid-row: span 2; }
  }

  .hp-feature {
    position: relative;
    isolation: isolate;
    border: 1px solid var(--hp-border);
    background: linear-gradient(180deg, var(--hp-surface) 0%, rgba(14,12,24,0.55) 100%);
    border-radius: var(--hp-radius-lg);
    overflow: hidden;
    transition: border-color var(--hp-dur-med) var(--hp-ease), transform var(--hp-dur-med) var(--hp-ease);
  }
  .hp-feature:hover { border-color: rgba(244,183,102,0.35); transform: translateY(-3px); }

  .hp-feature--lead {
    padding: clamp(40px, 4.5vw, 64px);
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 40px;
    background:
      radial-gradient(80% 80% at 20% 110%, rgba(244,183,102,0.18) 0%, transparent 60%),
      linear-gradient(180deg, var(--hp-surface-2) 0%, rgba(14,12,24,0.7) 100%);
    min-height: 440px;
  }
  .hp-feature__num {
    font-family: var(--hp-font-display);
    font-size: clamp(6rem, 13vw, 12rem);
    font-style: italic;
    color: var(--hp-aurora-1);
    letter-spacing: -0.05em;
    line-height: 0.85;
    align-self: end;
  }
  .hp-feature--lead .hp-feature__body { display: grid; gap: 18px; max-width: 32ch; }
  .hp-feature--lead .hp-feature__title {
    font-family: var(--hp-font-display);
    font-weight: 400;
    margin: 0;
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .hp-feature--lead .hp-feature__text {
    margin: 0;
    color: var(--hp-text-muted);
    font-size: clamp(1.05rem, 1.15vw, 1.18rem);
    line-height: 1.6;
  }

  .hp-feature__glow {
    position: absolute;
    width: 60%;
    aspect-ratio: 1;
    bottom: -30%;
    right: -10%;
    background: radial-gradient(circle, rgba(167,139,250,0.35), transparent 60%);
    filter: blur(60px);
    z-index: -1;
    pointer-events: none;
  }

  .hp-feature--sm {
    padding: 34px 32px;
    display: grid;
    gap: 16px;
    align-content: start;
    min-height: 220px;
  }
  .hp-feature--sm .hp-feature__icon {
    width: 64px; height: 64px;
    display: grid; place-items: center;
    border-radius: 16px;
    border: 1px solid var(--hp-border-strong);
    color: var(--hp-aurora-1);
    font-family: var(--hp-font-display);
    font-style: italic;
    font-size: 1.85rem;
    line-height: 1;
    background: rgba(244,183,102,0.06);
    margin-bottom: 4px;
  }
  .hp-feature--sm .hp-feature__title {
    font-family: var(--hp-font-display);
    font-weight: 400;
    margin: 0;
    font-size: 1.6rem;
    color: var(--hp-text);
    letter-spacing: -0.015em;
    line-height: 1.1;
  }
  .hp-feature--sm .hp-feature__text {
    margin: 0;
    color: var(--hp-text-muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Features — Editorial",
  "tag": "section",
  "class": "hp-section hp-section--features",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Specs" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Allt du behöver för en riktig hemmabio." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Ikon eller siffra", "default": "150″" },
        { "type": "text", "id": "heading", "label": "Rubrik", "default": "Upp till 150 tum" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Stor bild direkt på vägg — som en riktig biosalong i vardagsrummet." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features — Editorial",
      "blocks": [
        { "type": "feature", "settings": { "icon": "150″", "heading": "Upp till 150 tum", "text": "Stor bild direkt på vägg — som en riktig biosalong i vardagsrummet. Sluta nöja dig med små skärmar." } },
        { "type": "feature", "settings": { "icon": "4K", "heading": "4K Ultra HD", "text": "Skarpa, klara bilder i varje scen — varje detalj på sin plats." } },
        { "type": "feature", "settings": { "icon": "☀", "heading": "Hög ljusstyrka", "text": "Funkar även i ljusare rum, inte bara i totalt mörker." } },
        { "type": "feature", "settings": { "icon": "♪", "heading": "Inbyggda högtalare", "text": "Tydligt ljud utan extern högtalare. Anslut Bluetooth när du vill ha mer." } },
        { "type": "feature", "settings": { "icon": "⇆", "heading": "WiFi · BT · HDMI · USB", "text": "Streama trådlöst från mobil, dator, spelkonsol eller TV-box." } },
        { "type": "feature", "settings": { "icon": "▶", "heading": "Bio · sport · spel · serier", "text": "Allt som finns på din skärm — bara större. Direkt på din vägg." } }
      ]
    }
  ]
}
{% endschema %}
