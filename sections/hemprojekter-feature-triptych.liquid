<section class="hp-features">
  <div class="hp-container--wide">
    <div class="hp-section-label hp-reveal">
      <span class="hp-section-label__num">03 / 06</span>
      <span class="hp-section-label__title">{{ section.settings.kicker | default: 'Specs' }}</span>
    </div>

    {%- if section.settings.heading != blank -%}
      <h2 class="hp-display hp-features__title hp-reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="hp-features__grid">
      {%- for block in section.blocks -%}
        {%- assign img = block.settings.image_url -%}
        {%- if block.settings.image != blank -%}
          {%- assign img = block.settings.image | image_url: width: 1600 -%}
        {%- endif -%}
        <article class="hp-feature hp-feature--{{ forloop.index }} hp-reveal" {{ block.shopify_attributes }} style="transition-delay: {{ forloop.index0 | times: 60 }}ms">
          <div class="hp-feature__media">
            {%- if img != blank -%}
              <img src="{{ img }}" alt="{{ block.settings.heading | escape }}" loading="lazy" width="1600" height="1200">
            {%- endif -%}
            <div class="hp-feature__media-grad" aria-hidden="true"></div>
            <span class="hp-feature__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          </div>
          <div class="hp-feature__body">
            {%- if block.settings.icon != blank -%}
              <span class="hp-feature__chip" aria-hidden="true">{{ block.settings.icon }}</span>
            {%- endif -%}
            <h3 class="hp-feature__title">{{ block.settings.heading }}</h3>
            <p class="hp-feature__text">{{ block.settings.text }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hp-features { padding-block: var(--hp-section-pad-y); position: relative; }

  .hp-features__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    margin: 0 0 clamp(40px, 5vw, 72px);
    text-wrap: balance;
    letter-spacing: -0.03em;
    max-width: 22ch;
  }

  .hp-features__grid {
    display: grid;
    gap: clamp(16px, 1.4vw, 24px);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .hp-features__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1080px) {
    .hp-features__grid {
      grid-template-columns: repeat(12, 1fr);
      grid-auto-rows: 200px;
    }
    /* Lead 150" — tall hero, left */
    .hp-feature--1 { grid-column: span 7; grid-row: span 3; }
    /* 4K — top-right, wide-ish */
    .hp-feature--2 { grid-column: span 5; grid-row: span 2; }
    /* Brightness — middle-right */
    .hp-feature--3 { grid-column: span 5; grid-row: span 1; }
    /* Three squares bottom row */
    .hp-feature--4 { grid-column: span 4; grid-row: span 2; }
    .hp-feature--5 { grid-column: span 4; grid-row: span 2; }
    .hp-feature--6 { grid-column: span 4; grid-row: span 2; }
  }

  .hp-feature {
    position: relative;
    isolation: isolate;
    border-radius: var(--hp-radius-lg);
    overflow: hidden;
    background: var(--hp-surface);
    border: 1px solid var(--hp-border);
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 360px;
    transition: transform var(--hp-dur-med) var(--hp-ease), border-color var(--hp-dur-med) var(--hp-ease), box-shadow var(--hp-dur-med) var(--hp-ease);
  }
  .hp-feature:hover {
    transform: translateY(-3px);
    border-color: rgba(244,183,102,0.35);
    box-shadow: 0 40px 100px -30px rgba(244,183,102,0.18);
  }

  .hp-feature__media {
    position: relative;
    overflow: hidden;
    min-height: 240px;
  }
  .hp-feature__media img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
    display: block;
    transition: transform 1.2s var(--hp-ease);
  }
  .hp-feature:hover .hp-feature__media img { transform: scale(1.04); }

  .hp-feature__media-grad {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(7,6,12,0) 50%, rgba(7,6,12,0.7) 100%);
    pointer-events: none;
  }

  .hp-feature__num {
    position: absolute;
    top: 18px; right: 22px;
    font-family: var(--hp-font-display);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--hp-aurora-1);
    letter-spacing: -0.02em;
    text-shadow: 0 2px 14px rgba(0,0,0,0.7);
    z-index: 1;
  }

  .hp-feature__body {
    padding: clamp(24px, 2vw, 32px) clamp(26px, 2vw, 34px) clamp(28px, 2.2vw, 36px);
    display: grid;
    gap: 12px;
    align-content: start;
    background: linear-gradient(180deg, rgba(20,17,31,0.4) 0%, rgba(20,17,31,0.0) 100%);
  }
  .hp-feature__chip {
    width: 44px; height: 44px;
    display: grid; place-items: center;
    border-radius: 12px;
    border: 1px solid rgba(244,183,102,0.45);
    color: var(--hp-aurora-1);
    font-family: var(--hp-font-display);
    font-style: italic;
    font-size: 1.4rem;
    line-height: 1;
    background: rgba(244,183,102,0.1);
    margin-bottom: 2px;
  }
  .hp-feature__title {
    font-family: var(--hp-font-display);
    font-weight: 400;
    margin: 0;
    font-size: clamp(1.8rem, 2.3vw, 2.2rem);
    color: var(--hp-text);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .hp-feature__text {
    margin: 0;
    color: var(--hp-text-muted);
    font-size: clamp(1.05rem, 1.15vw, 1.18rem);
    line-height: 1.55;
  }

  /* Lead card gets bigger title */
  @media (min-width: 1080px) {
    .hp-feature--1 .hp-feature__title { font-size: clamp(2.4rem, 3vw, 3rem); }
    .hp-feature--1 .hp-feature__text { font-size: clamp(1.15rem, 1.3vw, 1.32rem); max-width: 38ch; }
    .hp-feature--1 .hp-feature__media { min-height: 0; }
    .hp-feature--1 .hp-feature__num { font-size: 2.4rem; top: 24px; right: 28px; }
  }
{% endstylesheet %}

