<section class="hp-features">
  <div class="hp-container">
    <div class="hp-features__head">
      <p class="hp-kicker">{{ section.settings.kicker }}</p>
      {%- if section.settings.heading != blank -%}
        <h2 class="hp-display hp-features__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    <ul class="hp-features__grid" role="list">
      {%- for block in section.blocks -%}
        <li class="hp-feature" {{ block.shopify_attributes }}>
          <span class="hp-feature__icon" aria-hidden="true">{{ block.settings.icon }}</span>
          <h3 class="hp-feature__title">{{ block.settings.heading }}</h3>
          <p class="hp-feature__body hp-body">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .hp-features { padding-block: var(--hp-section-pad-y); background: var(--hp-bg); }
  .hp-features__head { text-align: center; display: grid; gap: 12px; margin-bottom: clamp(32px, 5vw, 64px); }
  .hp-features__title { font-size: clamp(2.2rem, 4.6vw, 3.6rem); margin: 0; text-wrap: balance; letter-spacing: -0.02em; max-width: 22ch; margin-inline: auto; }
  .hp-features__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 16px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .hp-features__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 960px) {
    .hp-features__grid { grid-template-columns: repeat(3, 1fr); }
  }
  .hp-feature {
    padding: 32px 28px;
    border-radius: var(--hp-radius-lg);
    border: 1px solid var(--hp-border);
    background:
      radial-gradient(120% 100% at 0% 0%, rgba(167, 139, 250, 0.10) 0%, transparent 60%),
      linear-gradient(180deg, var(--hp-surface) 0%, rgba(17, 23, 58, 0.5) 100%);
    display: grid;
    gap: 14px;
    transition: transform var(--hp-dur-med) var(--hp-ease), border-color var(--hp-dur-med) var(--hp-ease), box-shadow var(--hp-dur-med) var(--hp-ease);
    position: relative;
    isolation: isolate;
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-feature { transition: none; }
  }
  .hp-feature:hover {
    transform: translateY(-4px);
    border-color: rgba(167, 139, 250, 0.4);
    box-shadow: 0 30px 60px -30px rgba(167, 139, 250, 0.4);
  }
  .hp-feature__icon {
    width: 56px; height: 56px;
    display: grid; place-items: center;
    background: linear-gradient(135deg, var(--hp-aurora-2), var(--hp-aurora-3));
    color: #0B1026;
    border-radius: 14px;
    font-family: var(--hp-font-display);
    font-size: 1.3rem;
    font-weight: 500;
  }
  .hp-feature__title {
    font-family: var(--hp-font-display);
    font-weight: 400;
    margin: 0;
    font-size: 1.55rem;
    color: var(--hp-text);
    letter-spacing: -0.01em;
  }
  .hp-feature__body { margin: 0; font-size: 0.96rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Features — Triptych",
  "tag": "section",
  "class": "hp-section hp-section--features",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Specs" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Allt du behöver för en riktig hemmabio." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Ikon", "default": "◱" },
        { "type": "text", "id": "heading", "label": "Rubrik", "default": "Upp till 150\"" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Stor bild direkt på vägg — som en riktig biosalong i vardagsrummet." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features — Triptych",
      "blocks": [
        { "type": "feature", "settings": { "icon": "◱", "heading": "Upp till 150\"", "text": "Stor bild direkt på vägg — som en riktig biosalong i vardagsrummet." } },
        { "type": "feature", "settings": { "icon": "4K", "heading": "4K Ultra HD", "text": "Skarpa, klara bilder i varje scen — varje detalj på sin plats." } },
        { "type": "feature", "settings": { "icon": "☀", "heading": "Hög ljusstyrka", "text": "Funkar även i ljusare rum, inte bara i totalt mörker." } },
        { "type": "feature", "settings": { "icon": "♪", "heading": "Inbyggda högtalare", "text": "Tydligt ljud utan externa högtalare. Anslut Bluetooth när du vill ha mer." } },
        { "type": "feature", "settings": { "icon": "⇆", "heading": "WiFi · BT · HDMI · USB", "text": "Streama trådlöst från mobil, dator, spelkonsol eller TV-box." } },
        { "type": "feature", "settings": { "icon": "▶", "heading": "Bio, sport, spel, serier", "text": "Allt som finns på din skärm — bara större. Direkt på din vägg." } }
      ]
    }
  ]
}
{% endschema %}
