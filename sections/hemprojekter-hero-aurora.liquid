<section class="hp-hero" id="shopify-section-{{ section.id }}">
  <div class="hp-aurora-bloom" aria-hidden="true"></div>

  <div class="hp-hero__inner hp-container">
    <div class="hp-hero__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="hp-kicker hp-hero__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hp-display hp-hero__title">{{ section.settings.heading | replace: '<p>', '' | replace: '</p>', '' }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hp-body hp-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="hp-hero__cta">
        <a class="hp-button hp-button--primary" href="{{ section.settings.cta_url }}" data-hero-cta>
          {{ section.settings.cta_label }}
        </a>
        {%- if section.settings.secondary_label != blank -%}
          <a class="hp-button hp-button--ghost" href="{{ section.settings.secondary_url }}">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.klarna_line != blank -%}
        <p class="hp-hero__klarna">{{ section.settings.klarna_line }}</p>
      {%- endif -%}
    </div>

    <div class="hp-hero__media">
      <div class="hp-hero__media-frame">
        <video class="hp-hero__video"
               {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1920 }}"{% else %}poster="https://cdn.shopify.com/s/files/1/0939/9867/8401/files/demo-after.png?v=1779053709"{% endif %}
               autoplay muted loop playsinline preload="metadata">
          {%- if section.settings.video != blank -%}
            {%- for source in section.settings.video.sources -%}
              <source src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
          {%- else -%}
            <source src="https://cdn.shopify.com/videos/c/o/v/f07717c51c434626a1b1ffd14f80b604.mp4" type="video/mp4">
          {%- endif -%}
        </video>
        <div class="hp-hero__media-glow" aria-hidden="true"></div>
      </div>
    </div>
  </div>

  <a class="hp-hero__scroll" href="#hp-after-hero" aria-label="Scrolla för att se mer">
    <span></span>
  </a>
</section>

<div id="hp-after-hero" tabindex="-1"></div>

{% stylesheet %}
  .hp-hero {
    position: relative;
    min-height: clamp(640px, 100vh, 1000px);
    overflow: hidden;
    isolation: isolate;
    background: var(--hp-bg);
    margin-top: calc(-1 * var(--hp-header-h));
    padding-top: var(--hp-header-h);
    display: grid;
    align-items: center;
  }

  .hp-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(40px, 5vw, 72px);
    grid-template-columns: 1fr;
    padding-block: clamp(48px, 8vh, 96px);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hp-hero__inner { grid-template-columns: 1.05fr 1fr; }
  }

  .hp-hero__copy {
    display: grid;
    gap: 22px;
    justify-items: start;
    text-align: left;
    max-width: 38rem;
  }

  .hp-hero__kicker { margin: 0; }

  .hp-hero__title {
    font-size: clamp(3rem, 7.5vw, 6.6rem);
    margin: 0;
    text-wrap: balance;
    letter-spacing: -0.03em;
    line-height: 0.98;
  }

  .hp-hero__sub {
    font-size: clamp(1.05rem, 1.4vw, 1.25rem);
    max-width: 48ch;
    margin: 6px 0 0;
    color: var(--hp-text);
    opacity: 0.84;
  }

  .hp-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
  }

  .hp-hero__klarna {
    font-family: var(--hp-font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--hp-text-muted);
    margin: 4px 0 0;
  }

  .hp-hero__media {
    position: relative;
    width: 100%;
  }

  .hp-hero__media-frame {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--hp-radius-lg);
    overflow: hidden;
    border: 1px solid var(--hp-border-strong);
    background: var(--hp-surface);
    box-shadow:
      0 50px 120px -40px rgba(0, 0, 0, 0.7),
      0 24px 60px -20px rgba(167, 139, 250, 0.35);
  }

  .hp-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hp-hero__media-glow {
    position: absolute;
    inset: -8% -10% -20% -10%;
    z-index: -1;
    background:
      radial-gradient(60% 60% at 20% 100%, rgba(167, 139, 250, 0.55), transparent 60%),
      radial-gradient(60% 60% at 90% 0%, rgba(124, 255, 203, 0.4), transparent 60%);
    filter: blur(50px);
    opacity: 0.9;
  }

  .hp-hero__scroll {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: 22px; height: 36px;
    border: 1px solid var(--hp-border-strong);
    border-radius: 999px;
    z-index: 3;
    display: grid;
    place-items: start center;
    padding-top: 6px;
  }
  .hp-hero__scroll span {
    width: 3px; height: 8px;
    background: var(--hp-aurora-1);
    border-radius: 999px;
    animation: hp-scroll 1.8s var(--hp-ease) infinite;
  }
  @keyframes hp-scroll {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(14px); opacity: 0; }
    100% { transform: translateY(14px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-hero__scroll span { animation: none; }
  }

  @media (max-width: 640px) {
    .hp-hero { min-height: 92vh; }
    .hp-hero__title { font-size: clamp(2.6rem, 11vw, 4rem); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Aurora",
  "tag": "section",
  "class": "hp-section hp-section--hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker (liten etikett ovanför rubrik)", "default": "Mini-projektor · 4K Ultra HD" },
    { "type": "richtext", "id": "heading", "label": "Rubrik (richtext — använd <em> för markerade ord)", "default": "<p>Din hemmabio. Direkt på <em>din vägg.</em></p>" },
    { "type": "textarea", "id": "subheading", "label": "Underrubrik", "default": "Streama från mobil, dator eller spelkonsol. Upp till 150 tum, skarp 4K-bild, inbyggda högtalare — på sekunder." },
    { "type": "text", "id": "cta_label", "label": "CTA-text", "default": "Köp nu — 499 kr" },
    { "type": "url", "id": "cta_url", "label": "CTA-länk" },
    { "type": "text", "id": "secondary_label", "label": "Sekundär länk-text", "default": "Se demo" },
    { "type": "url", "id": "secondary_url", "label": "Sekundär länk" },
    { "type": "text", "id": "klarna_line", "label": "Klarna-rad", "default": "Eller 4 räntefria delbetalningar via Klarna." },
    { "type": "image_picker", "id": "poster", "label": "Bild / video-poster" },
    { "type": "video", "id": "video", "label": "Hero-video (mp4). Lämna tom för att använda standardvideon." }
  ],
  "presets": [ { "name": "Hero — Aurora" } ]
}
{% endschema %}
