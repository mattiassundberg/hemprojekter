<section class="hp-hero" id="shopify-section-{{ section.id }}">
  <div class="hp-hero__media" aria-hidden="true">
    <video class="hp-hero__video"
           {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 2400 }}"{% else %}poster="https://cdn.shopify.com/s/files/1/0939/9867/8401/files/demo-after.png?v=1779053709"{% endif %}
           autoplay muted loop playsinline preload="metadata">
      {%- if section.settings.video != blank -%}
        {%- for source in section.settings.video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      {%- else -%}
        <source src="https://cdn.shopify.com/videos/c/o/v/f07717c51c434626a1b1ffd14f80b604.mp4" type="video/mp4">
      {%- endif -%}
    </video>
    <div class="hp-hero__scrim"></div>
    <div class="hp-hero__vignette"></div>
  </div>

  <div class="hp-hero__top hp-container--wide">
    <span class="hp-hero__mark">01 · Hemmabio</span>
    <span class="hp-hero__mark hp-hero__mark--right">N° 720p</span>
  </div>

  <div class="hp-hero__content hp-container--wide">
    {%- if section.settings.kicker != blank -%}
      <p class="hp-kicker hp-hero__kicker">{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hp-display hp-hero__title">{{ section.settings.heading | replace: '<p>', '' | replace: '</p>', '' }}</h1>
    {%- endif -%}

    <div class="hp-hero__base">
      <div class="hp-hero__left">
        {%- if section.settings.subheading != blank -%}
          <p class="hp-body hp-hero__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
        <div class="hp-hero__cta">
          <a class="hp-button hp-button--primary" href="{{ section.settings.cta_url }}" data-hero-cta>
            {{ section.settings.cta_label }}
          </a>
          {%- if section.settings.secondary_label != blank -%}
            <a class="hp-button hp-button--ghost" href="{{ section.settings.secondary_url }}">
              {{ section.settings.secondary_label }}
            </a>
          {%- endif -%}
        </div>
        {%- if section.settings.klarna_line != blank -%}
          <p class="hp-hero__klarna">{{ section.settings.klarna_line }}</p>
        {%- endif -%}
      </div>

      <dl class="hp-hero__specs">
        <div><dt>Bildstorlek</dt><dd>upp till 150"</dd></div>
        <div><dt>Upplösning</dt><dd>4K Ultra HD</dd></div>
        <div><dt>Anslutning</dt><dd>WiFi · BT · HDMI · USB</dd></div>
      </dl>
    </div>
  </div>

  <a class="hp-hero__scroll" href="#hp-after-hero" aria-label="Scrolla för att se mer">
    <span class="hp-hero__scroll-label">Skrolla</span>
    <span class="hp-hero__scroll-dot"></span>
  </a>
</section>

<div id="hp-after-hero" tabindex="-1"></div>

{% stylesheet %}
  .hp-hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    background: var(--hp-bg);
    margin-top: calc(-1 * var(--hp-header-h));
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .hp-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }
  .hp-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.05);
  }
  .hp-hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgba(7,6,12,0.9) 0%, rgba(7,6,12,0.55) 28%, rgba(7,6,12,0.7) 55%, rgba(7,6,12,0.97) 100%),
      linear-gradient(90deg, rgba(7,6,12,0.85) 0%, rgba(7,6,12,0.3) 50%, rgba(7,6,12,0.6) 100%);
  }
  .hp-hero__vignette {
    position: absolute; inset: 0;
    background: radial-gradient(120% 80% at 50% 30%, transparent 0%, rgba(7,6,12,0.7) 100%);
    mix-blend-mode: multiply;
  }

  .hp-hero__top {
    position: relative;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    padding-block: calc(var(--hp-header-h) + 20px) 0;
    font-family: var(--hp-font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(251, 248, 243, 0.85);
    text-shadow: 0 2px 12px rgba(0,0,0,0.6);
  }
  .hp-hero__mark--right { color: var(--hp-aurora-1); }

  .hp-hero__content {
    position: relative;
    z-index: 3;
    align-self: end;
    padding-block: clamp(48px, 8vh, 88px);
    display: grid;
    gap: clamp(28px, 4vw, 56px);
  }

  .hp-hero__kicker { color: var(--hp-aurora-1); }

  .hp-hero__title {
    font-size: clamp(3.4rem, 11vw, 11rem);
    margin: 0;
    text-wrap: balance;
    letter-spacing: -0.045em;
    line-height: 0.9;
    max-width: 14ch;
  }

  .hp-hero__base {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(28px, 4vw, 64px);
    align-items: end;
  }
  @media (min-width: 880px) {
    .hp-hero__base { grid-template-columns: 1.3fr 1fr; }
  }

  .hp-hero__left { display: grid; gap: 20px; max-width: 44ch; }

  .hp-hero__sub {
    color: var(--hp-text);
    font-size: clamp(1.18rem, 1.55vw, 1.38rem);
    line-height: 1.5;
    margin: 0;
    text-shadow: 0 2px 16px rgba(0,0,0,0.65);
  }
  .hp-hero__kicker { text-shadow: 0 2px 12px rgba(0,0,0,0.6); }
  .hp-hero__title { text-shadow: 0 4px 40px rgba(0,0,0,0.55); }

  .hp-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 4px;
  }

  .hp-hero__klarna {
    font-family: var(--hp-font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.12em;
    color: rgba(251, 248, 243, 0.85);
    margin: 0;
    text-shadow: 0 2px 10px rgba(0,0,0,0.55);
  }

  .hp-hero__specs {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    border-top: 1px solid rgba(251, 248, 243, 0.35);
    padding-top: 22px;
    background: linear-gradient(180deg, transparent, rgba(7,6,12,0.55));
    border-radius: 0 0 8px 8px;
  }
  @media (min-width: 600px) {
    .hp-hero__specs { grid-template-columns: repeat(3, 1fr); gap: 0; }
    .hp-hero__specs > div { padding-right: 18px; }
    .hp-hero__specs > div + div { border-left: 1px solid rgba(251, 248, 243, 0.25); padding-left: 18px; }
  }
  .hp-hero__specs dt {
    font-family: var(--hp-font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--hp-aurora-1);
    margin-bottom: 8px;
    text-shadow: 0 2px 10px rgba(0,0,0,0.65);
  }
  .hp-hero__specs dd {
    margin: 0;
    font-family: var(--hp-font-display);
    font-size: clamp(1.3rem, 1.7vw, 1.65rem);
    color: var(--hp-text);
    letter-spacing: -0.01em;
    text-shadow: 0 2px 14px rgba(0,0,0,0.7);
  }

  .hp-hero__scroll {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: grid;
    place-items: center;
    gap: 10px;
    text-decoration: none;
    color: rgba(251, 248, 243, 0.9);
    font-family: var(--hp-font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-shadow: 0 2px 10px rgba(0,0,0,0.6);
  }
  .hp-hero__scroll-dot {
    width: 6px; height: 6px;
    background: var(--hp-aurora-1);
    border-radius: 50%;
    animation: hp-scroll-dot 1.6s var(--hp-ease) infinite;
  }
  @keyframes hp-scroll-dot {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(8px); opacity: 0; }
    100% { transform: translateY(8px); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hp-hero__scroll-dot { animation: none; }
    .hp-hero__video { transform: none; }
  }

  @media (max-width: 640px) {
    .hp-hero__title { font-size: clamp(3rem, 13vw, 5rem); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Aurora",
  "tag": "section",
  "class": "hp-section hp-section--hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker (liten etikett ovanför rubrik)", "default": "Mini-projektor · 4K Ultra HD" },
    { "type": "richtext", "id": "heading", "label": "Rubrik (richtext — använd <em> för markerade ord)", "default": "<p>Din hemmabio. Direkt på <em>din vägg.</em></p>" },
    { "type": "textarea", "id": "subheading", "label": "Underrubrik", "default": "Streama från mobil, dator eller spelkonsol. Upp till 150 tum, skarp 4K-bild, inbyggda högtalare — på sekunder." },
    { "type": "text", "id": "cta_label", "label": "CTA-text", "default": "Köp nu — 499 kr" },
    { "type": "url", "id": "cta_url", "label": "CTA-länk" },
    { "type": "text", "id": "secondary_label", "label": "Sekundär länk-text", "default": "Se demo" },
    { "type": "url", "id": "secondary_url", "label": "Sekundär länk" },
    { "type": "text", "id": "klarna_line", "label": "Klarna-rad", "default": "Eller 4 räntefria delbetalningar via Klarna." },
    { "type": "image_picker", "id": "poster", "label": "Bild / video-poster" },
    { "type": "video", "id": "video", "label": "Hero-video (mp4). Lämna tom för standard." }
  ],
  "presets": [ { "name": "Hero — Aurora" } ]
}
{% endschema %}
