<header class="hp-header" role="banner">
  <div class="hp-header__inner hp-container">
    <a class="hp-header__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
      <span class="hp-logo" aria-hidden="true">{{- 'hemprojekter-logo.svg' | inline_asset_content -}}</span>
      <span class="hp-wordmark visually-hidden">Hemprojekter</span>
    </a>

    <nav class="hp-header__actions" aria-label="Genvägar">
      <a class="hp-iconbtn hp-iconbtn--cart" href="{{ routes.cart_url }}" data-cart-toggle aria-label="Varukorg ({{ cart.item_count }})">
        <span aria-hidden="true">{{- 'icon-cart.svg' | inline_asset_content -}}</span>
        {% if cart.item_count > 0 %}
          <span class="hp-iconbtn__count">{{ cart.item_count }}</span>
        {% endif %}
      </a>
    </nav>
  </div>
</header>

{% stylesheet %}
  .hp-header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background: transparent;
    border-bottom: 1px solid transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hp-header {
      transition: background-color var(--hp-dur-med) var(--hp-ease),
                  backdrop-filter var(--hp-dur-med) var(--hp-ease),
                  -webkit-backdrop-filter var(--hp-dur-med) var(--hp-ease),
                  border-color var(--hp-dur-med) var(--hp-ease);
    }
  }

  .hp-header.is-stuck {
    background: rgba(7, 6, 12, 0.78);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom-color: var(--hp-border-strong);
  }

  .hp-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 16px;
  }

  .hp-header__brand {
    display: inline-flex;
    text-decoration: none;
    color: var(--hp-text);
    min-width: 0;
    flex-shrink: 1;
  }

  .hp-wordmark {
    font-family: var(--hp-font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 1.5vw, 1.55rem);
    letter-spacing: -0.01em;
  }

  .hp-logo {
    display: block;
    line-height: 0;
    max-width: 100%;
  }
  .hp-logo svg {
    display: block;
    height: clamp(44px, 5vw, 64px);
    width: auto;
    max-width: 100%;
    overflow: visible;
  }
  .hp-logo svg text { font-family: "Forum", "Cormorant Garamond", "Times New Roman", serif; }
  @media (max-width: 480px) {
    .hp-logo svg { height: 38px; }
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  .hp-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hp-iconbtn {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    color: var(--hp-text);
    text-decoration: none;
    border: 1px solid var(--hp-border-strong);
    background: rgba(7, 6, 12, 0.55);
    transition: border-color var(--hp-dur-fast) var(--hp-ease),
                color var(--hp-dur-fast) var(--hp-ease),
                background-color var(--hp-dur-fast) var(--hp-ease);
  }

  .hp-iconbtn svg {
    width: 40px;
    height: 40px;
    display: block;
  }
  .hp-iconbtn > span {
    display: grid;
    place-items: center;
    line-height: 0;
  }

  .hp-iconbtn:hover {
    border-color: var(--hp-aurora-1);
    color: var(--hp-aurora-1);
  }

  .hp-iconbtn:focus-visible,
  .hp-header__brand:focus-visible {
    outline: 2px solid var(--hp-aurora-1);
    outline-offset: 3px;
  }

  .hp-iconbtn__count {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--hp-aurora-3);
    color: #0B1026;
    font-size: 11px;
    font-weight: 700;
    display: grid;
    place-items: center;
  }
{% endstylesheet %}

<script>
  (function () {
    if (window.__hpHeaderInit) return;
    window.__hpHeaderInit = true;
    function attach() {
      var header = document.querySelector('.hp-header');
      if (!header) return;
      var io = new IntersectionObserver(function (entries) {
        header.classList.toggle('is-stuck', entries[0].intersectionRatio < 1);
      }, { threshold: [1], rootMargin: '-1px 0px 0px 0px' });
      io.observe(header);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', attach);
    } else {
      attach();
    }
  })();
</script>

